@page "/"

<PageTitle>Smart-X Gateway</PageTitle>

<div class="smartx-home">

    <div class="hero-section">
        <h1>SMART-X</h1>
        <p>IoT Mesh Ecosystem Gateway</p>
        <span>Telemetry • Automation • Intelligent Monitoring</span>
    </div>

    <div class="pillar-grid">

        <div class="pillar active">
            <div class="pillar-icon">📡</div>

            <h2>Sensor Data Ingestion</h2>

            <p>
                Register IoT sensors, ingest telemetry and monitor
                real-time sensor activity.
            </p>

            <a href="/dashboard" class="pillar-button">
                Open Module
            </a>
        </div>

        <div class="pillar disabled">
            <div class="pillar-icon">⚡</div>

            <h2>Command Stream & History</h2>

            <p>
                Real-time device commands and historical command
                tracking.
            </p>

            <button disabled>
                Disabled — Part 2
            </button>
        </div>

        <div class="pillar disabled">
            <div class="pillar-icon">🌐</div>

            <h2>Network Topology & Mesh Routing</h2>

            <p>
                Visualise network nodes and Smart-X mesh routing.
            </p>

            <button disabled>
                Disabled — Final PoE
            </button>
        </div>

    </div>

</div>